# ============================================================================
#  仓库忽略规则
#  项目：面向人机交互风险实时评估的分层证据融合框架｜人机料法环五证据流
#  原则：只入库“可复现的文本、代码与审计证据”；本机工具状态、依赖缓存、
#        数据与凭据一律保留在磁盘但不入库。
#  维护：新增工具（如新的索引/缓存目录）时，在对应分节追加规则。
#  生成：2026-10-09（首次目录整理）
# ============================================================================

# ---------------------------------------------------------------------------
# 1. 凭据与敏感配置（严禁入库；密钥仅保存在本机）
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.*
secrets.*

# ---------------------------------------------------------------------------
# 2. 本机工具状态与运行数据（保留磁盘、不入库）
# ---------------------------------------------------------------------------
# Ultragoal/OMX：状态、handoff 证据树、便携运行时与缓存（约 19 GB；
# 如需将其中的审查证据入库，可对具体文件使用 `git add -f`）
.omx/
# 第三方检出（公开仓库，可随时重新 clone）
.integrations/
academic-research-skills/
# CodeGraph 本地索引（可再生；体积可达数十 GB）
.codegraph/
# 编辑器/代理本机状态
.agents/
.codex/
# openscience 工具运行产物（保留原位）
.openscience-codex/
openscience-output/
# WorkBuddy 运行数据；仅保留项目记忆（工作日志）入库
.workbuddy/*
!.workbuddy/memory/

# ---------------------------------------------------------------------------
# 3. 依赖与构建缓存（可再生）
# ---------------------------------------------------------------------------
**/.uv-cache/
**/uv-cache/
node_modules/
.npm/
**/__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# 4. 数据与外部材料（体积/许可原因不入库；保留在本机）
# ---------------------------------------------------------------------------
datasets/
DataSet/
研究方向调研-G1-G8/DataSet/
研究方向调研-G1-G8/related_work/
研究方向调研-G1-G8/research/.backup-*/
*.partial

# ---------------------------------------------------------------------------
# 5. 临时与派生文件
# ---------------------------------------------------------------------------
*.tmp
*.tmp.*
checklist.tmp.txt
*.inspect.ndjson
rfbtmp/
_docx文本提取/
**/.tmp-*/
os-temp-*/
pytest-tmp-*/
*.bak
*.orig
*.rej
*.dmp
*.stackdump
~$*
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
# 派生渲染/预览（可再生）
outputs/paper_render/
outputs/paper_render_final/
outputs/v66-workbook-preview/
outputs/v67-workbook-preview/
outputs/v67-workbook-roundtrip-preview/

# ---------------------------------------------------------------------------
# 6. 日志（默认忽略运行日志；审计证据日志定向放行）
# ---------------------------------------------------------------------------
*.log
!dataset-validation-evidence-20260727/**/*.log
!outputs/remote-shakedown/**/*.log
!outputs/restore-cache/**/*.log
!risk-fusion-bench/outputs/**/*.log

# ---------------------------------------------------------------------------
# 7. 历史归档（2026-10-09 用户决定：archive/ 仅保留本机，不随仓库上传）
# ---------------------------------------------------------------------------
archive/
