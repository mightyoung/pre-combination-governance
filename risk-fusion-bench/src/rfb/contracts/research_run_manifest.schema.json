{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "execution_protocol_id",
    "execution_lane",
    "classification",
    "formal_gate_effect",
    "formal_admission_eligible",
    "shk001b_eligible",
    "contains_formal_claims"
  ],
  "properties": {
    "manifest_phase": {"enum": ["user_manifest", "prepared_manifest", "execution_manifest"]},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "execution_protocol_id": {"enum": ["RFB_RESEARCH_LEGACY_R006", "RFB_MME_V1_EXACT27_LOCAL"]},
    "controller_nonce": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "gpu_policy": {"const": "cpu_only"},
    "formal_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prepared_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "preflight_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "preflight_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collected_at_utc", "monotonic_ns", "boot_id", "root",
        "approved_remote_parent", "remote_run_root", "hostname", "python_version",
        "source_tree_sha256", "package_inventory_sha256",
        "config_sha256", "input_manifest_sha256",
        "owned_process_snapshot_sha256", "foreign_process_snapshot_sha256",
        "mount_identity", "mountinfo_sha256", "filesystem_total_bytes", "filesystem_used_bytes",
        "filesystem_free_bytes", "project_tree_allocated_bytes", "filesystem_used_delta_bytes",
        "owned_external_layers_bytes", "open_deleted_bytes", "capacity_peak_bytes",
        "capacity_state", "capacity_buckets_bytes", "capacity_available", "remote_reserve_available",
        "dataset_manifest_sha256", "dataset_manifest_verified", "dataset_probe_status", "dataset_probe_reason",
        "gpu_policy", "gpu_identity", "gpu_inventory_sha256", "gpu_probe_status", "gpu_probe_reason",
        "gpu_process_snapshot_sha256", "prepared_manifest_sha256",
        "controller_nonce", "formal_snapshot_sha256", "fingerprint_verified",
        "runtime_format", "runtime_path", "runtime_file_sha256", "runtime_source_sha256",
        "runtime_manifest_sha256", "runtime_dependency_profile"
      ],
      "properties": {
        "collected_at_utc": {"type": "string", "format": "date-time"},
        "monotonic_ns": {"type": "integer", "minimum": 0},
        "boot_id": {"type": "string", "minLength": 1},
        "root": {"type": "string"},
        "approved_remote_parent": {"type": "string", "minLength": 1},
        "remote_run_root": {"type": "string", "minLength": 1},
        "hostname": {"type": "string", "minLength": 1},
        "python_version": {"type": "string", "minLength": 1},
        "source_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "package_inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "input_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "owned_process_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "foreign_process_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "mount_identity": {"type": "string", "minLength": 1},
        "mountinfo_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "filesystem_total_bytes": {"type": "integer", "minimum": 0},
        "filesystem_used_bytes": {"type": "integer", "minimum": 0},
        "filesystem_free_bytes": {"type": "integer", "minimum": 0},
        "project_tree_allocated_bytes": {"type": "integer", "minimum": 0},
        "filesystem_used_delta_bytes": {"type": "integer", "minimum": 0},
        "owned_external_layers_bytes": {"type": "integer", "minimum": 0},
        "open_deleted_bytes": {"type": "integer", "minimum": 0},
        "capacity_peak_bytes": {"type": "integer", "minimum": 0},
        "capacity_state": {"enum": ["PLANNED", "PLANNED_CAP_EXCEEDED", "DRAIN_AND_SEAL", "SAFE_HALT_CAP_BREACH", "SUBBUDGET_BREACH"]},
        "capacity_buckets_bytes": {
          "type": "object", "additionalProperties": false,
          "required": ["ephemeral_dataset", "durable_result_staging", "scratch_partial", "retry_quarantine_wal", "emergency_reserve"],
          "properties": {
            "ephemeral_dataset": {"type": "integer", "minimum": 0},
            "durable_result_staging": {"type": "integer", "minimum": 0},
            "scratch_partial": {"type": "integer", "minimum": 0},
            "retry_quarantine_wal": {"type": "integer", "minimum": 0},
            "emergency_reserve": {"type": "integer", "minimum": 0}
          }
        },
        "capacity_available": {"type": "boolean"},
        "remote_reserve_available": {"type": "boolean"},
        "dataset_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "dataset_manifest_verified": {"type": "boolean"},
        "dataset_probe_status": {"enum": ["OBSERVED", "NOT_APPLICABLE", "ERROR"]},
        "dataset_probe_reason": {"type": ["string", "null"]},
        "gpu_policy": {"const": "cpu_only"},
        "gpu_identity": {"type": "string", "minLength": 1},
        "gpu_inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "gpu_process_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "gpu_probe_status": {"enum": ["OBSERVED_NOT_USED", "NOT_APPLICABLE", "ERROR"]},
        "gpu_probe_reason": {"type": ["string", "null"]},
        "prepared_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "controller_nonce": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "formal_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "fingerprint_verified": {"const": true},
        "runtime_format": {"enum": ["python_zipapp_stdlib_v1", "python_pinned_venv_v1"]},
        "runtime_path": {"type": "string", "minLength": 1},
        "runtime_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "runtime_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "runtime_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "runtime_dependency_profile": {"enum": ["stdlib_only", "tep_nonconfirmatory_v1"]},
        "pinned_runtime_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pinned_runtime_closure_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "experiment_name": {"type": "string", "minLength": 1},
    "dataset_domain": {"type": "string", "minLength": 1},
    "bundle_manifest": {"type": "object"},
    "method_panel": {"type": "array"},
    "seeds": {"type": "array"},
    "algorithm_seed": {"type": "integer", "minimum": 0},
    "scorer_config": {"type": "object"},
    "resource_limits": {"type": "object"},
    "expected_output_contract": {"type": "object"},
    "local_root": {"type": "string"},
    "approved_remote_parent": {"type": "string", "minLength": 1},
    "remote_run_root": {"type": "string", "minLength": 1},
    "local_results": {"type": "string"},
    "staged_manifest_path": {"type": "string"},
    "dataset_root": {"type": "string"},
    "ssh_host": {"type": "string", "minLength": 1},
    "ssh_port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "known_hosts": {"type": "string", "minLength": 1},
    "expected_fingerprint": {"type": "string", "pattern": "^SHA256:[A-Za-z0-9+/]{43}$"},
    "runtime_format": {"enum": ["python_zipapp_stdlib_v1", "python_pinned_venv_v1"]},
    "runtime_path": {"type": "string", "minLength": 1},
    "runtime_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime_dependency_profile": {"enum": ["stdlib_only", "tep_nonconfirmatory_v1"]},
    "pinned_runtime_manifest": {"type": "object"},
    "pinned_runtime_root": {"type": "string", "minLength": 1},
    "pinned_runtime_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pinned_runtime_closure_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "run_root_creation_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remote_run_root", "approved_remote_parent", "run_id", "parent_device", "parent_inode", "run_root_device", "run_root_inode", "mount_identity", "created_at_ns"],
      "properties": {
        "remote_run_root": {"type": "string", "minLength": 1},
        "approved_remote_parent": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1},
        "parent_device": {"type": "integer", "minimum": 0},
        "parent_inode": {"type": "integer", "minimum": 0},
        "run_root_device": {"type": "integer", "minimum": 0},
        "run_root_inode": {"type": "integer", "minimum": 0},
        "mount_identity": {"type": "string", "minLength": 1},
        "created_at_ns": {"type": "integer", "minimum": 1}
      }
    },
    "adapter_id": {"type": "string", "minLength": 1},
    "adapter_params": {"type": "object"},
    "scientific_acceptance": {"type": "boolean"},
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planned_bytes", "drain_bytes", "dataset", "durable_result", "scratch_partial", "retry_quarantine_wal", "emergency_reserve", "telemetry"],
      "properties": {
        "planned_bytes": {"const": 22000000000},
        "drain_bytes": {"const": 24000000000},
        "dataset": {"const": 16000000000},
        "durable_result": {"const": 3000000000},
        "scratch_partial": {"const": 2000000000},
        "retry_quarantine_wal": {"const": 1000000000},
        "emergency_reserve": {"const": 3000000000},
        "telemetry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["project_tree_allocated_bytes", "filesystem_used_delta_bytes", "owned_external_layers_bytes", "open_deleted_bytes", "observed_peak_bytes"],
          "properties": {
            "project_tree_allocated_bytes": {"type": "integer", "minimum": 0},
            "filesystem_used_delta_bytes": {"type": "integer", "minimum": 0},
            "owned_external_layers_bytes": {"type": "integer", "minimum": 0},
            "open_deleted_bytes": {"type": "integer", "minimum": 0},
            "observed_peak_bytes": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "execution_lane": {"const": "RESEARCH"},
    "classification": {"const": "DEVELOPMENT_NONCONFIRMATORY"},
    "formal_gate_effect": {"const": "NONE"},
    "formal_admission_eligible": {"const": false},
    "shk001b_eligible": {"const": false},
    "contains_formal_claims": {"const": false}
  },
  "allOf": [
    {"if": {"required": ["runtime_format"], "properties": {"runtime_format": {"const": "python_zipapp_stdlib_v1"}}}, "then": {"properties": {"runtime_dependency_profile": {"const": "stdlib_only"}}, "not": {"required": ["pinned_runtime_manifest_sha256", "pinned_runtime_closure_fingerprint"]}}},
    {"if": {"required": ["runtime_format"], "properties": {"runtime_format": {"const": "python_pinned_venv_v1"}}}, "then": {"properties": {"runtime_dependency_profile": {"const": "tep_nonconfirmatory_v1"}}, "required": ["pinned_runtime_manifest_sha256", "pinned_runtime_closure_fingerprint"]}}
  ]
}

