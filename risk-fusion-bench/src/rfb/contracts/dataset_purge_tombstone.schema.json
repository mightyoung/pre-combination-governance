{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dataset_purge_tombstone.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event",
    "pass",
    "development_only",
    "local_live_gate_passed",
    "live_status",
    "segment_id",
    "plan_hash",
    "manifest_hash",
    "purge_ledger_head",
    "ephemeral_files_remaining",
    "residual_paths",
    "open_deleted_bytes",
    "open_deleted_measurement",
    "filesystem_used_bytes_before",
    "filesystem_used_bytes_after",
    "expected_reclaimed_bytes",
    "observed_reclaimed_bytes",
    "space_tolerance_bytes",
    "unexplained_delta",
    "archive_a_rechecked",
    "archive_b_rechecked",
    "archive_expected_commitment_sha256",
    "tombstone_hash"
  ],
  "properties": {
    "schema_version": {"const": "dataset-purge-tombstone.v2"},
    "event": {"const": "DATASET_PURGED"},
    "pass": {"const": true},
    "development_only": {"const": true},
    "local_live_gate_passed": {"const": false},
    "live_status": {"const": "PENDING"},
    "segment_id": {"type": "string", "minLength": 1},
    "plan_hash": {"$ref": "#/$defs/hash"},
    "manifest_hash": {"$ref": "#/$defs/hash"},
    "purge_ledger_head": {"$ref": "#/$defs/hash"},
    "ephemeral_files_remaining": {"const": 0},
    "residual_paths": {"type": "array", "maxItems": 0},
    "open_deleted_bytes": {"const": 0},
    "open_deleted_measurement": {"type": "string", "minLength": 1},
    "filesystem_used_bytes_before": {"type": "integer", "minimum": 0},
    "filesystem_used_bytes_after": {"type": "integer", "minimum": 0},
    "expected_reclaimed_bytes": {"type": "integer", "minimum": 0},
    "observed_reclaimed_bytes": {"type": "integer", "minimum": 0},
    "space_tolerance_bytes": {"type": "integer", "minimum": 0},
    "unexplained_delta": {"const": 0},
    "archive_a_rechecked": {"const": true},
    "archive_b_rechecked": {"const": true},
    "archive_expected_commitment_sha256": {"$ref": "#/$defs/hash"},
    "tombstone_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
