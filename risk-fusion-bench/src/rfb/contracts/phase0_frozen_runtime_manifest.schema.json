{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "python", "sealed_flags", "user_site_enabled", "pythonpath_accepted", "root_local", "probe", "source_binding", "contracts", "distributions", "native_closure", "runtime_tree_sha256", "runtime_files", "bytecode_files", "materialization", "environment_id", "manifest_self_sha256"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "python": {
      "type": "object", "additionalProperties": false,
      "required": ["implementation", "version", "executable", "sha256"],
      "properties": {
        "implementation": {"const": "CPython"}, "version": {"const": "3.11.14"},
        "executable": {"const": "@ROOT/python.exe"}, "sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "sealed_flags": {"const": ["-I", "-S", "-B"]},
    "user_site_enabled": {"const": false},
    "pythonpath_accepted": {"const": false},
    "root_local": {"const": true},
    "probe": {
      "type": "object", "additionalProperties": false,
      "required": ["executable", "prefix", "base_prefix", "sys_path", "isolated", "no_site", "dont_write_bytecode"],
      "properties": {
        "executable": {"type": "string"}, "prefix": {"type": "string"}, "base_prefix": {"type": "string"},
        "sys_path": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "isolated": {"const": 1}, "no_site": {"const": 1}, "dont_write_bytecode": {"const": true}
      }
    },
    "source_binding": {
      "type": "object", "additionalProperties": false, "required": ["files", "source_set_sha256"],
      "properties": {
        "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceFile"}},
        "source_set_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "contracts": {
      "type": "object", "additionalProperties": false,
      "required": ["files", "files_sha256", "test_plan", "test_plan_sha256", "receipt_derivation_contract", "receipt_derivation_contract_sha256"],
      "properties": {
        "files": {"type": "array", "minItems": 6, "items": {"$ref": "#/$defs/sourceFile"}},
        "files_sha256": {"$ref": "#/$defs/hash"},
        "test_plan": {"type": "object"},
        "test_plan_sha256": {"$ref": "#/$defs/hash"},
        "receipt_derivation_contract": {"type": "object"},
        "receipt_derivation_contract_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "distributions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/distribution"}},
    "native_closure": {
      "type": "object", "additionalProperties": false,
      "required": ["policy", "normal_and_delay_imports", "system_dlls", "unresolved"],
      "properties": {
        "policy": {"const": "ROOT_LOCAL_RECURSIVE_OR_PINNED_SYSTEM32_OR_WINDOWS_API_SET"},
        "normal_and_delay_imports": {"type": "array", "items": {"$ref": "#/$defs/import"}},
        "system_dlls": {"type": "array", "items": {"$ref": "#/$defs/systemDll"}},
        "unresolved": {"const": []}
      }
    },
    "runtime_tree_sha256": {"$ref": "#/$defs/hash"},
    "runtime_files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
    "bytecode_files": {"const": 0},
    "materialization": {
      "type": "object", "additionalProperties": false,
      "required": ["workspace_root", "runtime_root", "clean_python_root", "probe", "system_dll_paths"],
      "properties": {
        "workspace_root": {"type": "string", "minLength": 1},
        "runtime_root": {"type": "string", "minLength": 1},
        "clean_python_root": {"type": "string", "minLength": 1},
        "probe": {"type": "object"},
        "system_dll_paths": {"type": "array", "items": {"$ref": "#/$defs/materializedSystemDll"}}
      }
    },
    "environment_id": {"$ref": "#/$defs/hash"},
    "manifest_self_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sourceFile": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}}},
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "size", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "size": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/hash"}}},
    "distribution": {"type": "object", "additionalProperties": false, "required": ["name", "version", "requirements", "metadata_sha256", "source_record_sha256", "record_sha256", "record_entries", "files"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "requirements": {"type": "array", "items": {"type": "string"}}, "metadata_sha256": {"$ref": "#/$defs/hash"}, "source_record_sha256": {"$ref": "#/$defs/hash"}, "record_sha256": {"$ref": "#/$defs/hash"}, "record_entries": {"type": "integer", "minimum": 1}, "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}}}},
    "import": {"type": "object", "additionalProperties": false, "required": ["binary", "kind", "name", "resolution"], "properties": {"binary": {"type": "string"}, "kind": {"enum": ["normal", "delay"]}, "name": {"type": "string"}, "resolution": {"enum": ["ROOT_LOCAL_SAME_DIRECTORY", "ROOT_LOCAL_UNIQUE", "WINDOWS_API_SET", "WINDOWS_SYSTEM32_PINNED", "UNRESOLVED"]}}},
    "systemDll": {"type": "object", "additionalProperties": false, "required": ["name", "location", "sha256"], "properties": {"name": {"type": "string"}, "location": {"type": "string", "pattern": "^@SYSTEM32/"}, "sha256": {"$ref": "#/$defs/hash"}}},
    "materializedSystemDll": {"type": "object", "additionalProperties": false, "required": ["name", "path", "sha256"], "properties": {"name": {"type": "string"}, "path": {"type": "string"}, "sha256": {"$ref": "#/$defs/hash"}}}
  }
}
