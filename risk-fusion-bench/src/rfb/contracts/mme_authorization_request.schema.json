    "execution_scope": {"type": "object", "additionalProperties": false, "required": ["mode", "independent_blocks", "dataset_split", "remote_actions", "formal_writes", "d_test_access"], "properties": {"mode": {"const": "LOCAL_ONLY"}, "independent_blocks": {"const": 27}, "dataset_split": {"const": "D_development"}, "remote_actions": {"const": false}, "formal_writes": {"const": false}, "d_test_access": {"const": false}}},
    "classification": {"$ref": "#/$defs/classification"},
