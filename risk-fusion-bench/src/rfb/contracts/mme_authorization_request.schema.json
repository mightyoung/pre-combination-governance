  "properties": {
    "schema_version": {"const": "1.0.0"},
    "status": {"const": "DRAFT_UNSIGNED"},
    "execution_protocol_id": {"const": "RFB_MME_V1_EXACT27_LOCAL"},
    "request_nonce": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
