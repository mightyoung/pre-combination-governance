    "expires_at_utc": {"type": "string", "format": "date-time"},
    "bindings": {"$ref": "#/$defs/bindings"},
    "request_id": {"$ref": "#/$defs/hash"},
    "request_self_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
