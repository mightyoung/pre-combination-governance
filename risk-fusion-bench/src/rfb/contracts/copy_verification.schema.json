{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "R005 COPY_VERIFICATION evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "execution_lane", "classification",
    "formal_gate_effect", "formal_admission_eligible", "shk001b_eligible",
    "contains_formal_claims", "runtime_format", "runtime_path",
    "runtime_file_sha256", "runtime_source_sha256", "runtime_manifest_sha256",
    "runtime_dependency_profile",
    "prepared_manifest_sha256", "execution_manifest_sha256",
    "preflight_evidence_sha256", "remote_receipt_hash",
    "remote_receipt_self_hash", "remote_result_tree_sha256",
    "local_result_tree_sha256", "equal_tree", "remote_result_path",
    "local_result_path", "verified_at_utc", "directory_durable", "self_hash"
  ],
  "properties": {
    "schema_version": {"const": "copy-verification.v6"},
    "run_id": {"type": "string", "minLength": 1},
    "execution_lane": {"const": "RESEARCH"},
    "classification": {"const": "DEVELOPMENT_NONCONFIRMATORY"},
    "formal_gate_effect": {"const": "NONE"},
    "formal_admission_eligible": {"const": false},
    "shk001b_eligible": {"const": false},
    "contains_formal_claims": {"const": false},
    "runtime_format": {"enum": ["python_zipapp_stdlib_v1", "python_pinned_venv_v1"]},
    "runtime_path": {"type": "string", "minLength": 1},
    "runtime_file_sha256": {"$ref": "#/$defs/hash"},
    "runtime_source_sha256": {"$ref": "#/$defs/hash"},
    "runtime_manifest_sha256": {"$ref": "#/$defs/hash"},
    "runtime_dependency_profile": {"enum": ["stdlib_only", "tep_nonconfirmatory_v1"]},
    "pinned_runtime_manifest_sha256": {"$ref": "#/$defs/hash"},
    "pinned_runtime_closure_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "prepared_manifest_sha256": {"$ref": "#/$defs/hash"},
    "execution_manifest_sha256": {"$ref": "#/$defs/hash"},
    "preflight_evidence_sha256": {"$ref": "#/$defs/hash"},
    "remote_receipt_hash": {"$ref": "#/$defs/hash"},
    "remote_receipt_self_hash": {"$ref": "#/$defs/hash"},
    "remote_result_tree_sha256": {"$ref": "#/$defs/hash"},
    "local_result_tree_sha256": {"$ref": "#/$defs/hash"},
    "equal_tree": {"const": true},
    "remote_result_path": {"type": "string", "minLength": 1},
    "local_result_path": {"type": "string", "minLength": 1},
    "verified_at_utc": {"type": "string", "format": "date-time"},
    "directory_durable": {"const": true},
    "self_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
  "allOf": [{"if": {"required": ["runtime_dependency_profile"], "properties": {"runtime_dependency_profile": {"const": "tep_nonconfirmatory_v1"}}}, "then": {"required": ["pinned_runtime_manifest_sha256", "pinned_runtime_closure_fingerprint"]}}]
}
