{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rfb:research:mme-v2:prediction",
  "type": "object",
  "required": [
    "method_id",
    "status",
    "risk_interval",
    "action_state",
    "failure_code"
  ],
  "properties": {
    "method_id": {
      "enum": [
        "Proposed",
        "B1",
        "B2",
        "ES-Rebuild",
        "B0",
        "B3",
        "B4",
        "B5"
      ]
    },
    "status": {
      "enum": [
        "SUCCEEDED",
        "FAILED"
      ]
    },
    "risk_interval": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      ]
    },
    "action_state": {
      "enum": [
        "ACT",
        "REVIEW",
        "NO_ACTION"
      ]
    },
    "failure_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "bpa": {
      "type": "object",
      "required": [
        "frame",
        "focal_sets",
        "masses"
      ],
      "additionalProperties": false,
      "properties": {
        "frame": {
          "const": [
            "RISK",
            "NOT_RISK"
          ]
        },
        "focal_sets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "RISK",
                "NOT_RISK"
              ]
            }
          }
        },
        "masses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "SUCCEEDED"
          }
        }
      },
      "then": {
        "properties": {
          "risk_interval": {
            "type": "array"
          },
          "action_state": {
            "enum": [
              "ACT",
              "REVIEW"
            ]
          },
          "failure_code": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "risk_interval": {
            "type": "null"
          },
          "action_state": {
            "const": "NO_ACTION"
          },
          "failure_code": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
