{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "runtime_format", "runtime_dependency_profile", "classification", "target_platform", "interpreter", "source_root_relative", "ordered_sys_path_policy", "site_packages_relative", "locked_distributions", "dependency_lock_sha256", "requirements_relative", "runtime_profile_relative", "requirements_sha256", "runtime_profile_sha256", "runtime_lock_sha256", "sysconfig_paths", "stdlib_evidence", "approved_external_roots", "distribution_roots", "import_origins", "native_extensions", "native_seed_inventory", "linked_libraries", "native_linker", "rfb_source_inventory", "rfb_source_inventory_sha256", "remote_materialization_verified", "closure_fingerprint"],
  "properties": {
    "schema_version": {"const": "pinned-runtime-manifest.v1"},
    "runtime_format": {"const": "python_pinned_venv_v1"},
    "runtime_dependency_profile": {"const": "tep_nonconfirmatory_v1"},
    "classification": {"const": "DEVELOPMENT_NONCONFIRMATORY"},
    "target_platform": {"type": "string", "minLength": 1},
    "interpreter": {"type": "object", "additionalProperties": false, "required": ["relative_path", "sha256", "version", "implementation", "abi", "build", "sysconfig"], "properties": {"relative_path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "version": {"type": "string"}, "implementation": {"type": "string"}, "abi": {"type": "string"}, "build": {"type": "string"}, "sysconfig": {"type": "object", "additionalProperties": {"type": "string"}}}},
    "source_root_relative": {"type": "string"},
    "ordered_sys_path_policy": {"type": "array", "items": {"type": "string"}},
    "site_packages_relative": {"type": ["string", "null"]},
    "requirements_relative": {"type": "string"},
    "runtime_profile_relative": {"type": "string"},
    "requirements_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime_profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sysconfig_paths": {"type": "object", "additionalProperties": {"type": "string"}},
    "stdlib_evidence": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "tree_sha256"], "properties": {"path": {"type": "string"}, "tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "approved_external_roots": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path"], "properties": {"path": {"type": "string"}}}},
    "distribution_roots": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "root", "tree_sha256"], "properties": {"name": {"type": "string"}, "root": {"type": "string"}, "tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "import_origins": {"type": "object", "additionalProperties": {"type": "string"}},
    "locked_distributions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "version", "files", "tree_sha256"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "files": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "size": {"type": "integer", "minimum": 0}}}}, "tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "dependency_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "native_extensions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "size": {"type": "integer", "minimum": 0}}}},
    "native_seed_inventory": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "size": {"type": "integer", "minimum": 0}}}},
    "linked_libraries": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "size": {"type": "integer", "minimum": 0}}}},
    "native_linker": {"oneOf": [{"type": "object", "additionalProperties": false, "maxProperties": 0}, {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "size": {"type": "integer", "minimum": 0}}}]},
    "rfb_source_inventory": {"type": "array"},
    "rfb_source_inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "remote_materialization_verified": {"const": false},
    "closure_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
