{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pcg:identifiability-paired-cpu:score:v1",
  "title": "Separate oracle-scored research result",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version", "task_id", "run_id", "task_status", "terminal_exit_code",
    "research_acceptance", "planned_method_invocations", "method_start_requests",
    "method_invocations_started", "completed_method_invocations", "partial",
    "output_sha256", "task_manifest_sha256", "oracle_sha256", "oracle_case_map_sha256", "plan_sha256",
    "source_commits", "schema_hashes", "first_alert_acceptance",
    "physical_notification_acceptance", "first_alert_checks", "physical_alert_checks",
    "event_pair_metrics", "rejection_denominator", "production_truth_denominator",
    "production_accuracy", "delivery_status", "scope_note"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"const": "PCG-IDENTIFIABILITY-PAIRED-CPU-001"},
    "run_id": {"type": "string", "minLength": 1},
    "task_status": {"const": "PASS"},
    "terminal_exit_code": {"const": 0},
    "research_acceptance": {"enum": ["TRUE", "FALSE"]},
    "planned_method_invocations": {"const": 80},
    "method_start_requests": {"const": 80},
    "method_invocations_started": {"const": 80},
    "completed_method_invocations": {"const": 80},
    "partial": {"const": false},
    "output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "task_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "oracle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "oracle_case_map_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_commits": {"type": "object"},
    "schema_hashes": {"type": "object"},
    "first_alert_acceptance": {"type": "boolean"},
    "physical_notification_acceptance": {"type": "boolean"},
    "first_alert_checks": {"type": "array", "items": {"type": "object"}},
    "physical_alert_checks": {"type": "array", "items": {"type": "object"}},
    "event_pair_metrics": {"type": "array", "items": {"type": "object"}},
    "rejection_denominator": {"type": "integer", "minimum": 0},
    "production_truth_denominator": {"const": 0},
    "production_accuracy": {"const": "NOT_COMPUTABLE"},
    "delivery_status": {"const": "NOT_DELIVERED"},
    "scope_note": {"type": "string", "minLength": 1}
  }
}
